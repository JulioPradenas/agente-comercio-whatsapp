# Copiar a .env y completar. Nunca commitear .env

# API de comercio simulada (rutas /pvt/)
COMMERCE_APP_KEY=hogartec-dev-key
COMMERCE_APP_TOKEN=hogartec-dev-token

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
FALLBACK_CHAT_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Supabase: botón "Connect" > Connection string > Session pooler (URI)
DATABASE_URL=

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=          # inventa un string largo; lo pegarás también en Meta
WHATSAPP_APP_SECRET=            # App settings > Basic > App secret
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_DEMO_CUSTOMER_PHONE=56989910085   # tu número se atiende como este cliente sintético


# Langfuse (cloud.langfuse.com > proyecto > Settings > API Keys): trazas, latencia y costo
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
